import { profile, technicalSkills, competencies, experience, projects, education, certifications } from './data.js';
import './App.css';

function SectionTitle({ first, accent }) {
  return <h2 className="section-title">{first} <span>{accent}</span></h2>;
}

function Card({ children }) {
  return <article className="card">{children}</article>;
}

function App() {
  return (
    <>
      <header className="nav">
        <a className="brand" href="#home">{profile.firstName} <span>{profile.lastName}</span></a>
        <nav aria-label="Main navigation">
          {['About','Skills','Competencies','Experience','Projects','Education','Certifications','Contact'].map(item =>
            <a key={item} href={'#' + item.toLowerCase()}>{item}</a>
          )}
        </nav>
      </header>

      <main>
        <section className="hero" id="home">
          <p className="eyebrow">{profile.headline}</p>
          <h1>Hi, I'm {profile.firstName} <span>{profile.lastName}.</span></h1>
          <p className="hero-copy">{profile.introduction}</p>
          <div className="actions">
            <a className="button" href="#experience">View My Experience</a>
            <a className="button outline" href="#contact">Get In Touch</a>
          </div>
        </section>

        <section id="about">
          <SectionTitle first="About" accent="Me" />
          <p className="intro">{profile.about}</p>
        </section>

        <section id="skills">
          <SectionTitle first="Technical" accent="Skills" />
          <div className="tile-grid">{technicalSkills.map(skill => <div className="tile" key={skill}>{skill}</div>)}</div>
        </section>

        <section id="competencies">
          <SectionTitle first="Core" accent="Competencies" />
          <div className="tile-grid">{competencies.map(skill => <div className="tile" key={skill}>{skill}</div>)}</div>
        </section>

        <section id="experience">
          <SectionTitle first="Professional" accent="Experience" />
          <div className="card-grid">
            {experience.map((job, index) => (
              <Card key={`${job.company}-${job.role}-${index}`}>
                <h3>{job.role}</h3>
                <p className="accent-text">{job.company}</p>
                <p className="meta">{job.period}</p>
                <ul>{job.bullets.map(bullet => <li key={bullet}>{bullet}</li>)}</ul>
              </Card>
            ))}
          </div>
        </section>

        <section id="projects">
          <SectionTitle first="Featured" accent="Projects" />
          <div className="card-grid">
            {projects.map(project => (
              <Card key={project.title}>
                <p className="eyebrow">{project.type}</p>
                <h3>{project.title}</h3>
                <p>{project.description}</p>
                {project.detail && <p>{project.detail}</p>}
              </Card>
            ))}
          </div>
        </section>

        <section id="education">
          <SectionTitle first="Education" accent="" />
          <div className="card-grid">
            {education.map(item => <Card key={item.qualification}>
              <h3>{item.qualification}</h3>
              <p className="accent-text">{item.institution}</p>
              <p className="meta">{item.period}</p>
              {item.note && <p>{item.note}</p>}
            </Card>)}
          </div>
        </section>

        <section id="certifications">
          <SectionTitle first="Training &" accent="Certifications" />
          <div className="card-grid">
            {certifications.map(item => <Card key={item.name}>
              <h3>{item.name}</h3>
              <p className="accent-text">{item.provider}</p>
              <p className="meta">{item.period}</p>
            </Card>)}
          </div>
        </section>

        <section id="contact">
          <SectionTitle first="Get In" accent="Touch" />
          <div className="contact-grid">
            <Card>
              <h3>Let's Talk</h3>
              <p>I am open to customer service, administrative, operations, programme support and business analytics opportunities.</p>
              {profile.email ? <a className="contact-link" href={`mailto:${profile.email}`}>{profile.email}</a> : <p className="note">Add your professional email in <code>src/data.js</code>.</p>}
              {profile.linkedin ? <a className="contact-link" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn profile</a> : <p className="note">Add your LinkedIn URL in <code>src/data.js</code>.</p>}
              <a className="contact-link" href={profile.github} target="_blank" rel="noreferrer">GitHub profile</a>
            </Card>
            <Card>
              <h3>Want to work together?</h3>
              <p>For professional enquiries, use the email or profile links on this page.</p>
              <p className="note">This first version uses direct contact links. A message form can be connected later if you want one.</p>
            </Card>
          </div>
        </section>
      </main>
      <footer>© {new Date().getFullYear()} {profile.firstName} {profile.lastName}. All rights reserved.</footer>
    </>
  );
}

export default App;
